<Window x:Class="HackF5.UnitySpy.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HackF5.UnitySpy.Gui.ViewModels"
        Title="{Binding WindowTitle}"
        Height="820"
        Width="1280"
        MinHeight="520"
        MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshNodeCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Processes}"
                          SelectedItem="{Binding SelectedProcess}"
                          IsEnabled="{Binding IsIdle}"
                          DisplayMemberPath="DisplayName"
                          IsEditable="False"
                          MinWidth="280" />
                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="12,4"
                        Content="Refresh"
                        Command="{Binding RefreshProcessesCommand}" />
                <Button Grid.Column="2"
                        Margin="8,0,0,0"
                        Padding="12,4"
                        Content="Attach"
                        Command="{Binding AttachCommand}"
                        FontWeight="SemiBold" />
                <Button Grid.Column="3"
                        Margin="8,0,0,0"
                        Padding="12,4"
                        Content="Disconnect"
                        Command="{Binding DisconnectCommand}" />
                <TextBlock Grid.Column="4"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#EEEEEE"
                           Text="{Binding Status}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="140" MinHeight="80" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Row="0" Grid.Column="0" Margin="8">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6" Text="Types" />
                <TextBox DockPanel.Dock="Top"
                         Margin="0,0,0,6"
                         Text="{Binding TypeList.Filter, UpdateSourceTrigger=PropertyChanged}"
                         Padding="4,3">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="ToolTip" Value="Filter types by name" />
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <CheckBox Content="Types with static fields only"
                              IsChecked="{Binding TypeList.StaticsOnly}"
                              Margin="0,0,0,4" />
                    <CheckBox Content="Hearthstone shortcuts"
                              IsChecked="{Binding UseHearthstoneShortcuts}"
                              ToolTip="Singletons (s_instance), services, and NetCache entries" />
                </StackPanel>
                <ListBox ItemsSource="{Binding TypeList.VisibleTypes}"
                         SelectedItem="{Binding SelectedType}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TypeRowViewModel}">
                            <TextBlock Text="{Binding FullName}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasStaticFields}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsShortcut}" Value="True">
                                                <Setter Property="FontStyle" Value="Italic" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Row="0"
                          Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" />

            <DockPanel Grid.Row="0" Grid.Column="2" Margin="8">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6" Text="Inspector" />
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right"
                            Margin="6,0,0,0"
                            Padding="10,3"
                            Content="Copy C# path"
                            Command="{Binding CopyPathCommand}" />
                    <Button DockPanel.Dock="Right"
                            Margin="6,0,0,0"
                            Padding="10,3"
                            Content="Refresh"
                            Command="{Binding RefreshNodeCommand}" />
                    <Button DockPanel.Dock="Right"
                            Margin="6,0,0,0"
                            Padding="10,3"
                            Content="Back"
                            Command="{Binding PathBackCommand}" />
                    <TextBox FontFamily="Consolas"
                             VerticalContentAlignment="Center"
                             Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding ApplyPathCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <ItemsControl DockPanel.Dock="Top"
                              Margin="0,0,0,8"
                              ItemsSource="{Binding Breadcrumbs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BreadcrumbItem}">
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding DataContext.BreadcrumbCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Padding="6,2"
                                        Margin="0,0,2,2"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock x:Name="Label"
                                                       Text="{Binding Label}"
                                                       FontFamily="Consolas"
                                                       Foreground="#0B57D0" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                    <Setter TargetName="Label" Property="Foreground" Value="#222222" />
                                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Margin="2,2,6,0" Foreground="#888" Text="›">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid DockPanel.Dock="Top" Margin="19,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Name" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Type" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Value" FontWeight="SemiBold" />
                </Grid>

                <TreeView x:Name="InspectorTree"
                          ItemsSource="{Binding InspectorRoots}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          SelectedItemChanged="InspectorTree_OnSelectedItemChanged">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:InspectorNode}" ItemsSource="{Binding Children}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}"
                                           FontFamily="Consolas"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TypeName}"
                                           FontFamily="Consolas"
                                           Foreground="#666666"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ValueText}"
                                           FontFamily="Consolas"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Copy C# path" Command="{Binding CopyPathCommand}" />
                            <MenuItem Header="Copy value" Command="{Binding CopyValueCommand}" />
                            <MenuItem Header="Refresh" Command="{Binding RefreshNodeCommand}" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Row="1"
                          Grid.Column="0"
                          Grid.ColumnSpan="3"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          ResizeBehavior="PreviousAndNext" />

            <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="8,4,8,8">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,4" Text="Log" />
                <ListBox x:Name="LogList"
                         ItemsSource="{Binding LogLines}"
                         FontFamily="Consolas"
                         FontSize="11" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
